{
  "dart": "dart-assets",
  "version": 1,
  "_note": "Long hall: a 16 x 40 m corridor with staggered columns, walls with a gap at the south and north ends, a zone over the floor, four spawn points and the fight triggers (two waves, F01 then F02). Labels describe the shape; Paul may rename them. [Paul]",
  "assets": [
    {
      "name": "Long hall",
      "clip": {
        "dart": "dart-clip",
        "version": 1,
        "entries": {
          "prims": [
            { "id": "floor", "shape": "box", "pos": [0, -0.5, 0], "size": [16, 1, 40], "colour": "#6f6788", "behaviour": "solid" },
            { "id": "wall-s-l", "shape": "box", "pos": [-4.75, 2, 19.75], "size": [6.5, 4, 0.5], "colour": "#3a3550", "behaviour": "solid" },
            { "id": "wall-s-r", "shape": "box", "pos": [4.75, 2, 19.75], "size": [6.5, 4, 0.5], "colour": "#3a3550", "behaviour": "solid" },
            { "id": "wall-n-l", "shape": "box", "pos": [-4.75, 2, -19.75], "size": [6.5, 4, 0.5], "colour": "#3a3550", "behaviour": "solid" },
            { "id": "wall-n-r", "shape": "box", "pos": [4.75, 2, -19.75], "size": [6.5, 4, 0.5], "colour": "#3a3550", "behaviour": "solid" },
            { "id": "wall-w", "shape": "box", "pos": [-7.75, 2, 0], "size": [0.5, 4, 40], "colour": "#3a3550", "behaviour": "solid" },
            { "id": "wall-e", "shape": "box", "pos": [7.75, 2, 0], "size": [0.5, 4, 40], "colour": "#3a3550", "behaviour": "solid" },
            { "id": "column-1", "shape": "box", "pos": [-3.5, 2, -14], "size": [1.2, 4, 1.2], "colour": "#2ec4ff", "behaviour": "solid" },
            { "id": "column-2", "shape": "box", "pos": [3.5, 2, -8], "size": [1.2, 4, 1.2], "colour": "#2ec4ff", "behaviour": "solid" },
            { "id": "column-3", "shape": "box", "pos": [-3.5, 2, -2], "size": [1.2, 4, 1.2], "colour": "#2ec4ff", "behaviour": "solid" },
            { "id": "column-4", "shape": "box", "pos": [3.5, 2, 4], "size": [1.2, 4, 1.2], "colour": "#2ec4ff", "behaviour": "solid" },
            { "id": "column-5", "shape": "box", "pos": [-3.5, 2, 10], "size": [1.2, 4, 1.2], "colour": "#2ec4ff", "behaviour": "solid" },
            { "id": "column-6", "shape": "box", "pos": [3.5, 2, 16], "size": [1.2, 4, 1.2], "colour": "#2ec4ff", "behaviour": "solid" },
            { "id": "blocker", "shape": "box", "pos": [0, 1.5, -19.75], "size": [3, 3, 0.5], "colour": "#ff4fa3", "behaviour": "solid", "hidden": true }
          ],
          "zones": [
            { "id": "arena-zone", "pos": [0, 1.25, 0], "size": [16, 2.5, 40] }
          ],
          "spawnPoints": [
            { "id": "sp-1", "pos": [-5, 0, -15], "facing": [0, 1, 0] },
            { "id": "sp-2", "pos": [5, 0, -15], "facing": [0, 1, 0] },
            { "id": "sp-3", "pos": [-5, 0, -11], "facing": [0, 1, 0] },
            { "id": "sp-4", "pos": [5, 0, -11], "facing": [0, 1, 0] }
          ],
          "triggers": [
            {
              "id": "arena-lock",
              "when": { "kind": "enter", "zone": "arena-zone" },
              "do": [
                { "kind": "show", "ids": ["blocker"] },
                { "kind": "spawn", "id": "wave-1-spawn", "foamer": "F01", "count": 3, "at": ["sp-1", "sp-2", "sp-3", "sp-4"], "holdSeconds": 0.5 }
              ]
            },
            {
              "id": "arena-wave-2",
              "when": { "kind": "killed", "ids": ["wave-1-spawn"] },
              "do": [
                { "kind": "spawn", "id": "wave-2-spawn", "foamer": "F02", "count": 2, "at": ["sp-1", "sp-2", "sp-3", "sp-4"], "holdSeconds": 0.5 }
              ]
            },
            {
              "id": "arena-clear",
              "when": { "kind": "killed", "ids": ["wave-1-spawn", "wave-2-spawn"] },
              "do": [
                { "kind": "hide", "ids": ["blocker"] }
              ]
            }
          ]
        }
      },
      "picture": ""
    }
  ]
}
